{
  "expo": {
    "name": "D&S Admin",
    "slug": "ds-admin-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dsadmin",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dsfoodreviews.admin",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Used to record review videos and take thumbnail photos.",
        "NSPhotoLibraryUsageDescription": "Used to pick review videos and thumbnail photos to upload.",
        "NSMicrophoneUsageDescription": "Used by the camera when recording review videos.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#c8102e",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.dsfoodreviews.admin"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow D&S Admin to access your photos to upload review thumbnails and videos."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#c8102e",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
